# Backend (see backend/app/config.py for every setting)
APP_ENV=dev
DATABASE_URL=postgresql+psycopg://rs_app:rs_app@localhost:5432/reporting
MIGRATION_DATABASE_URL=postgresql+psycopg://rs_owner:rs_owner@localhost:5432/reporting
JWT_SECRET=change-me-to-32+-random-bytes
PLATFORM_KEY=change-me-platform-key          # encrypts Slack webhook URLs at rest
PUBLIC_WEB_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173
EMAIL_BACKEND=console                          # console | smtp (SES SMTP works)
# --- LLM for report drafting (no key at all => figures-only drafts, no AI call) -------------------------------
AI_PROVIDER=auto                               # auto (first provider with a key) | anthropic | openai | gemini | none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini-2024-07-18            # pinned dated ids; upgrade only after the golden set passes
OPENAI_BASE_URL=https://api.openai.com/v1      # any OpenAI-compatible endpoint (Azure OpenAI, vLLM, Ollama, ...)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-001
# The LLM is configured here only (platform level); there is no UI for it in this phase.
GOOGLE_CLIENT_ID=                              # enables Google sign-in
STORAGE_DIR=./var/files
# Frontend
VITE_GOOGLE_CLIENT_ID=
